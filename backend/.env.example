PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/ai_interview

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@aiinterview.com
ADMIN_PASSWORD=your_admin_password_here

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INTERVIEW_DEFAULT_DURATION_MINUTES=5

# AI Provider Configuration
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Mail Provider Configuration (Brevo REST API or SMTP)
MAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Aparaitech Recruitment
MAIL_REPLY_TO=support@example.com
SUPPORT_EMAIL=support@example.com
CANDIDATE_PORTAL_URL=http://localhost:5173/interview

# WhatsApp Provider Configuration (Optional)
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_TEMPLATE_NAME=interview_invitation

# Storage Configuration
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# System & Proctoring Mock Providers for Development
FACE_PROVIDER=development
STT_PROVIDER=development
TTS_PROVIDER=browser
